{
    "project_scope": "project_domain_id:%(domain_id)s and project_id:%(project_id)s",
    "domain_scope": "domain_id:%(domain_id)s",
    "cluster_admin": "role:cloud_resource_admin",
    "cluster_viewer": "role:cloud_resource_viewer or rule:cluster_admin",
    "domain_editor": "rule:cluster_admin or (rule:domain_scope and role:resource_admin)",
    "domain_viewer": "rule:cluster_viewer or (rule:domain_scope and role:resource_viewer) or rule:domain_editor",
    "project_editor": "rule:domain_editor or (rule:project_scope and role:resource_admin)",
    "project_viewer": "rule:domain_viewer or (rule:project_scope and role:resource_viewer) or rule:project_editor",

    "project:list": "rule:domain_viewer",
    "project:show": "rule:project_viewer",
    "project:edit": "rule:project_editor",
    "project:edit_as_outside_admin": "rule:domain_editor",
    "project:sync": "rule:project_editor",
    "project:set_rate_limit": "rule:domain_editor",
    "project:discover": "rule:domain_editor",
    "project:uncommit": "rule:cluster_admin",

    "domain:list": "rule:cluster_admin",
    "domain:show": "rule:domain_viewer",
    "domain:discover": "rule:cluster_admin",

    "cluster:list": "rule:cluster_admin",
    "cluster:show": "rule:cluster_admin",
    "cluster:show_basic": "role:admin or role:member or role:resource_admin or role:resource_viewer",
    "cluster:show_subcapacity": "compute:%(service)s and ram:%(resource)s",
    "cluster:show_errors": "rule:cluster_admin",
    "cluster:edit": "rule:cluster_admin",

    "v2_project_scope":  "project_domain_id:%(domain_uuid)s and project_id:%(project_uuid)s",
    "v2_domain_scope":   "domain_id:%(domain_uuid)s",
    "v2_cluster_admin":  "role:cloud_resource_admin",
    "v2_cluster_viewer": "role:cloud_resource_viewer or rule:v2_cluster_admin",
    "v2_domain_admin":   "rule:v2_cluster_admin or (rule:v2_domain_scope and role:resource_admin)",
    "v2_domain_viewer":  "rule:v2_cluster_viewer or (rule:v2_domain_scope and role:resource_viewer) or rule:v2_domain_admin",
    "v2_project_admin":  "rule:v2_domain_admin or (rule:v2_project_scope and role:resource_admin)",
    "v2_project_viewer": "rule:v2_domain_viewer or (rule:v2_project_scope and role:resource_viewer) or rule:v2_project_admin",

    "v2:meta:no_error_obfuscation": "rule:v2_cluster_admin",

    "v2:project:info": "rule:v2_project_viewer",
    "v2:project:report_single": "rule:v2_project_viewer",
    "v2:project:report_multiple": "rule:v2_domain_viewer",
    "v2:project:with_historical_usage": "rule:v2_cluster_viewer",
    "v2:project:with_obsolete": "rule:v2_cluster_viewer",
    "v2:project:with_subresources": "rule:v2_cluster_viewer",
    "v2:project:with_timing": "rule:v2_cluster_viewer",
    "v2:project:commitment_create": "rule:v2_project_admin",
    "v2:project:commitment_delete": "rule:v2_project_admin",
    "v2:project:commitment_delete_admin": "rule:v2_cluster_admin",
    "v2:project:commitment_get": "rule:v2_project_viewer",
    "v2:project_commitment_get_public": "rule:v2_cluster_viewer or role:resource_admin or role:resource_viewer",
    "v2:project_commitment_get_unscoped": "rule:v2_cluster_viewer",

    "v2:domain:info": "rule:v2_domain_viewer",
    "v2:domain:report_single": "rule:v2_domain_viewer",
    "v2:domain:report_multiple": "rule:v2_cluster_viewer",

    "v2:cluster:info": "rule:v2_cluster_viewer",
    "v2:cluster:report_single": "rule:v2_cluster_viewer",
    "v2:cluster:validation": "project_name:service and project_domain_name:Default and user_name:limes-validation and user_domain_name:Default"
}
