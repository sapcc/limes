# HELP limes_acpq_duration_secs Duration of the last ACPQ (apply computed project quota) run for this resource, in seconds.
# TYPE limes_acpq_duration_secs gauge
limes_acpq_duration_secs{resource="things",service="shared",service_name="shared"} 5
# HELP limes_autogrow_growth_multiplier For resources with quota distribution model "autogrow", reports the configured growth multiplier.
# TYPE limes_autogrow_growth_multiplier gauge
limes_autogrow_growth_multiplier{resource="things",service="shared",service_name="shared"} 1
# HELP limes_cluster_capacity Reported capacity of a Limes resource for an OpenStack cluster.
# TYPE limes_cluster_capacity gauge
limes_cluster_capacity{resource="things",service="shared",service_name="shared"} 30
# HELP limes_cluster_capacity_per_az Reported capacity of a Limes resource for an OpenStack cluster in a specific availability zone.
# TYPE limes_cluster_capacity_per_az gauge
limes_cluster_capacity_per_az{availability_zone="az-one",resource="things",service="shared",service_name="shared"} 15
limes_cluster_capacity_per_az{availability_zone="az-two",resource="things",service="shared",service_name="shared"} 15
# HELP limes_cluster_resource_quota_overcommit_reduction_percentage How much of the quota overcommit was reduced by the ACPQ algorithm. Values between 0 and 100. For resources without reduce_quota_overcommit_from_allocated_percent window, this jumps between 0 and 100.
# TYPE limes_cluster_resource_quota_overcommit_reduction_percentage gauge
limes_cluster_resource_quota_overcommit_reduction_percentage{availability_zone="any",resource="things",service="shared",service_name="shared"} 0
limes_cluster_resource_quota_overcommit_reduction_percentage{availability_zone="az-one",resource="things",service="shared",service_name="shared"} 0
limes_cluster_resource_quota_overcommit_reduction_percentage{availability_zone="az-two",resource="things",service="shared",service_name="shared"} 0
# HELP limes_cluster_usage_per_az Actual usage of a Limes resource for an OpenStack cluster in a specific availability zone.
# TYPE limes_cluster_usage_per_az gauge
limes_cluster_usage_per_az{availability_zone="az-one",resource="things",service="shared",service_name="shared"} 3
limes_cluster_usage_per_az{availability_zone="az-two",resource="things",service="shared",service_name="shared"} 3
# HELP limes_unit_multiplier Conversion factor that a value of this resource must be multiplied with to obtain the base unit (e.g. bytes). For use with Grafana when only the base unit can be configured because of templating.
# TYPE limes_unit_multiplier gauge
limes_unit_multiplier{resource="things",service="shared",service_name="shared"} 1
